WEB_PORT=8080
VITE_APP_NAME=个人工具箱
VITE_APP_SHORT_NAME=工具箱
VITE_APP_DESCRIPTION=常用开发、文件、图片与文档工具
VITE_REPOSITORY_URL=
VITE_OWNER_NAME=
VITE_OWNER_URL=
VITE_SUPPORT_URL=

ALLOWED_ORIGINS=http://localhost:8080
DOCUMENT_SERVICE_BASE_URL=
# 仅填写服务端密钥，不要使用 VITE_* 变量或提交真实值。
DOCUMENT_SERVICE_API_KEY=
DOCUMENT_SERVICE_TIMEOUT_MS=180000
DOCUMENT_SERVICE_MAX_CONCURRENCY=1
MAX_FILE_BYTES=104857600
MAX_REQUEST_BYTES=262144000
MAX_OUTPUT_BYTES=262144000
REQUEST_TIMEOUT_MS=300000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
# Compose 默认只有 Web Nginx 这一层可信反向代理。
TRUST_PROXY_HOPS=1
ENABLE_API_DOCS=true
