HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# 逗号分隔。生产环境请填写实际前端来源，不建议使用 *。
ALLOWED_ORIGINS=http://localhost:5173

# 文档处理服务地址，例如自建服务的 http://document-service:8080。
DOCUMENT_SERVICE_BASE_URL=
DOCUMENT_SERVICE_API_KEY=
DOCUMENT_SERVICE_TIMEOUT_MS=180000

MAX_FILE_BYTES=104857600
MAX_REQUEST_BYTES=262144000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
ENABLE_API_DOCS=true
