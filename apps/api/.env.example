HOST=0.0.0.0
PORT=3001
LOG_LEVEL=info

# 逗号分隔。生产环境请填写实际前端来源，不建议使用 *。
ALLOWED_ORIGINS=http://localhost:5173

# 文档处理服务地址，例如私有容器网络中的 http://document-engine:8080。
# 当前 HTTP 绑定的兼容性和真实测试方式见 docs/DOCUMENT-ENGINE.md。
DOCUMENT_SERVICE_BASE_URL=
DOCUMENT_SERVICE_API_KEY=
DOCUMENT_SERVICE_TIMEOUT_MS=180000
DOCUMENT_SERVICE_MAX_CONCURRENCY=1

MAX_FILE_BYTES=104857600
MAX_REQUEST_BYTES=262144000
MAX_OUTPUT_BYTES=262144000
REQUEST_TIMEOUT_MS=300000
RATE_LIMIT_MAX=60
RATE_LIMIT_WINDOW=1 minute
# 直连 API 保持 0；每经过一层可信反向代理增加 1。
TRUST_PROXY_HOPS=0
ENABLE_API_DOCS=true
