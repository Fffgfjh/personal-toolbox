# 品牌与链接（均为构建时配置）
VITE_APP_NAME=个人工具箱
VITE_APP_SHORT_NAME=工具箱
VITE_APP_DESCRIPTION=常用开发、文件、图片与文档工具
VITE_REPOSITORY_URL=
VITE_OWNER_NAME=
VITE_OWNER_URL=
VITE_SUPPORT_URL=

# 独立 API 地址。开发时留空使用 Vite 的 /api 代理；跨域部署时填写完整地址。
VITE_API_BASE_URL=/api
VITE_DEV_API_PROXY_TARGET=http://localhost:3001

# 部署到子路径时，例如 GitHub Pages 的 /personal-toolbox/
BASE_URL=/
